# Copy to collector.env. Lines are compatible with bash and systemd EnvironmentFile.
UPSTREAM_BASE_URL=http://127.0.0.1:8000/v1
PROXY_HOST=127.0.0.1
PROXY_PORT=9000
UPSTREAM_READ_TIMEOUT=600
# Optional for loopback-only service. Set a real secret before non-loopback binding.
PROXY_API_KEY=
# Optional: the MODEL SERVER'S key. Incoming proxy API keys are never forwarded.
UPSTREAM_API_KEY=
# RAW/native Responses always retain returned reasoning. 1 also includes visible reasoning in SFT.
INCLUDE_REASONING=0
# qwen (default): normalize Chat system/developer positions. off: byte passthrough.
CHAT_COMPAT_MODE=qwen
# Optional absolute storage path; default is this project's ./data
COLLECTOR_DATA_DIR=/mnt/data/zht/qwen-collector-proxy/data
