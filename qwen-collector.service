# User service. Install at ~/.config/systemd/user/qwen-collector.service
# Expected checkout: /mnt/data/qwen-collector-proxy
[Unit]
Description=Qwen OpenAI-compatible dataset capture proxy
After=network.target

[Service]
Type=simple
WorkingDirectory=/mnt/data/qwen-collector-proxy
ExecStart=/bin/bash /mnt/data/qwen-collector-proxy/start_proxy.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
